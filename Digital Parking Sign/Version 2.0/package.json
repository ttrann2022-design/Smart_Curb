import {firebaseConfig} from './config.js';
import {rankLots} from './scoring.js';
const $=id=>document.getElementById(id);
const NS='http://www.w3.org/2000/svg';
const layouts={
 fau:{title:'FAU — Original Sign',ids:['lotA','lotB','lotC','lotD'],labels:['A','B','C','D'],names:['Zone A','Zone B','Zone C','Zone D']},
 broward:{title:'Broward Mall',ids:['north','west','east','southeast','south'],labels:['N','W','E','SE','S'],names:['North — Island SPACE','West — Macy’s side','East — University Dr','Southeast — Regal / Macy’s','South — Federated Rd']}
};
let property='fau',mode='live',liveLots={},liveUnits={},demoLots={},demoUnits={},firebaseErrorMessage='',firebaseConnected=false;
const countsOf=stalls=>stalls.reduce((o,s)=>(o[s.state]++,o),{available:0,occupied:0,offline:0,unknown:0});
function status(u){if(!u)return 'unknown';if(u.online!==true)return 'offline';if(u.occupied===true)return 'occupied';if(u.occupied===false)return 'available';return 'unknown';}
function makeDemo(){demoLots={};demoUnits={};const layout=layouts[property];layout.ids.forEach((id,j)=>{demoLots[id]={name:layout.names[j]};let n=property==='broward'?[28,24,36,24,32][j]:24;for(let i=0;i<n;i++){let k=`${id}-space-${i+1}`;demoUnits[k]={lot:id,online:true,occupied:Math.random()<([.50,.35,.62,.75,.22][j]??.5)};}});}
function buildZones(lots,units){const layout=layouts[property];let ids=property==='broward'?layout.ids:Object.keys(lots).slice(0,4);if(property==='fau')for(const u of Object.values(units||{})){if(u?.lot&&!ids.includes(String(u.lot))&&ids.length<4)ids.push(String(u.lot));}return ids.map((id,i)=>{const stalls=Object.entries(units||{}).filter(([,u])=>u&&String(u.lot)===id).map(([sensorId,u])=>({sensorId,state:status(u)}));return{id,label:layout.labels[i]||String(i+1),name:lots[id]?.name||layout.names[i]||id,stalls,counts:countsOf(stalls)};});}
function bestZone(zones,lots,units){try{let ranked=rankLots(lots,units);let winner=ranked.find(x=>x.counts?.available>0&&zones.some(z=>z.id===x.id));if(winner)return zones.find(z=>z.id===winner.id);}catch(e){console.warn('Scoring fallback',e)}return zones.filter(z=>z.counts.available>0).sort((a,b)=>b.counts.available-a.counts.available)[0]||null;}
function svgEl(tag,attrs={},parent){const e=document.createElementNS(NS,tag);for(const[k,v]of Object.entries(attrs))e.setAttribute(k,String(v));if(parent)parent.append(e);return e;}
function txt(svg,x,y,text,cls,extra={}){let t=svgEl('text',{x,y,class:cls,...extra},svg);t.textContent=text;return t;}
function drawStalls(svg,zone,config){const {x,y,cols,rows,dx,dy,rotation=0}=config;let g=svgEl('g',{transform:`rotate(${rotation} ${x} ${y})`},svg);for(let i=0;i<cols*rows;i++){let col=i%cols,row=Math.floor(i/cols),px=x+col*dx,py=y+row*dy;svgEl('rect',{x:px,y:py,width:dx-2,height:dy-2,class:'stall'},g);const state=zone?.stalls[i]?.state||'unknown';svgEl('circle',{cx:px+dx/2,cy:py+dy/2,r:Math.min(5,dx/5,dy/4),class:`sensor ${state}`},g);}}
function mallMap(zones,best){const map=$('parkingMap');map.replaceChildren();const svg=svgEl('svg',{viewBox:'0 0 1100 1000',class:'mall-map',role:'img','aria-label':'Illustrative custom asphalt layout based on the supplied Broward Mall map reference'},map);svgEl('rect',{x:0,y:0,width:1100,height:1000,class:'map-bg'},svg);
// Five broad parking fields based on the user's supplied Google Maps screenshot.
const shapes={north:'M75 28 H770 L800 265 H570 L555 115 H300 V300 H75 Z',west:'M38 300 H300 L315 640 L215 780 H35 Z',east:'M625 210 H930 L1020 705 L785 680 L650 480 Z',southeast:'M760 580 H1020 V890 H710 L635 785 Z',south:'M195 765 L650 770 L730 880 L1030 890 V975 H85 V865 Z'};
for(const z of zones){svgEl('path',{d:shapes[z.id],class:`zone-shape ${best?.id===z.id?'recommended':''}`},svg);}
const roads=['M18 14 L18 965','M1070 20 L1070 960','M55 970 L1050 970','M50 320 L250 320 L320 275 L560 275 L675 360 L960 360','M60 705 L250 705 L345 735 L630 740 L770 790 L1040 790','M590 45 L590 220 L620 360 L660 520 L745 655'];for(const d of roads){svgEl('path',{d,class:'drive'},svg);svgEl('path',{d,class:'drive-center'},svg);}
const byId=Object.fromEntries(zones.map(z=>[z.id,z]));
drawStalls(svg,byId.north,{x:92,y:40,cols:16,rows:3,dx:29,dy:26});drawStalls(svg,byId.north,{x:610,y:44,cols:6,rows:6,dx:29,dy:25});
drawStalls(svg,byId.west,{x:60,y:365,cols:7,rows:13,dx:30,dy:23});
drawStalls(svg,byId.east,{x:730,y:255,cols:9,rows:13,dx:27,dy:22,rotation:-17});
drawStalls(svg,byId.southeast,{x:795,y:620,cols:7,rows:10,dx:28,dy:24,rotation:-20});
drawStalls(svg,byId.south,{x:260,y:820,cols:17,rows:5,dx:31,dy:25});
// Approximate mall footprint; not a survey or authoritative parking-space map.
svgEl('path',{d:'M305 145 H560 V285 L625 350 L615 475 L710 530 L795 600 L710 715 L600 705 L535 790 L445 740 L355 800 L270 710 L300 585 L245 535 L290 410 L300 315 Z',class:'mall-building'},svg);
svgEl('path',{d:'M325 170 H535 V290 L600 350 L585 470 L670 545 L740 600 L675 680 L585 665 L515 745 L445 690 L365 750 L305 690 L330 580 L275 525 L325 415 Z',class:'mall-roof'},svg);
txt(svg,482,457,'BROWARD', 'mall-label');txt(svg,482,482,'MALL','mall-label');txt(svg,480,505,'Custom asphalt schematic','mall-sub');
const labels=[['north',470,75,'NORTH'],['west',130,540,'WEST'],['east',865,400,'EAST'],['southeast',900,755,'SOUTHEAST'],['south',520,950,'SOUTH']];for(const[id,x,y,name]of labels)txt(svg,x,y,name,'zone-label');
txt(svg,1010,52,'N ↑','north');txt(svg,830,993,'FEDERATED RD','street-label');txt(svg,1080,490,'UNIVERSITY DR','street-label',{transform:'rotate(-90 1080 490)'});
}
function fauMap(zones,best){let root=$('parkingMap');root.replaceChildren();let shell=document.createElement('div');shell.className='fau-map';let grid=document.createElement('div');grid.className='fau-grid';for(let z of zones){let panel=document.createElement('div');panel.className='fau-zone'+(best?.id===z.id?' selected':'');let title=document.createElement('strong');title.textContent=`ZONE ${z.label} — ${z.counts.available} open`;panel.append(title);let stalls=document.createElement('div');stalls.className='fau-stalls';let n=Math.max(24,Math.min(48,z.stalls.length));for(let i=0;i<n;i++){let cell=document.createElement('div');cell.className='fau-stall';let dot=document.createElement('span');dot.className='dot '+(z.stalls[i]?.state||'unknown');cell.append(dot);stalls.append(cell);}panel.append(stalls);grid.append(panel);}shell.append(grid);root.append(shell);}
function draw(){const demo=mode==='demo';const lots=demo?demoLots:liveLots,units=demo?demoUnits:liveUnits;const zones=buildZones(lots,units),best=bestZone(zones,lots,units);$('mapTitle').textContent=layouts[property].title.toUpperCase()+' — PARKING MAP';$('modeLabel').textContent=demo?'SIMULATED DATA':'FIREBASE LIVE DATA';$('connection').textContent=demo?'● DEMO MODE':firebaseErrorMessage?'● FIREBASE ERROR':firebaseConnected?'● LIVE FIREBASE':'CONNECTING TO FIREBASE...';$('demo').textContent=demo?'Switch to Live Mode':'Switch to Demo Mode';$('demo').disabled=property==='broward';$('change').disabled=!demo;$('reset').disabled=!demo;$('bestZone').textContent=best?best.name.toUpperCase():'NO CONFIRMED OPEN LOT';$('bestCount').textContent=best?`${best.counts.available} confirmed available spaces`:'Waiting for confirmed available sensor data';const list=$('zoneList');list.replaceChildren();for(const z of zones){const row=document.createElement('div');row.className='zone-row'+(best?.id===z.id?' selected':'');const title=document.createElement('div');title.textContent=z.name;const sub=document.createElement('small');sub.textContent=`${z.counts.occupied} occupied · ${z.counts.offline} offline`;title.append(sub);const n=document.createElement('span');n.className='number';n.textContent=`${z.counts.available} / ${z.stalls.length}`;row.append(title,n);list.append(row);}if(property==='broward')mallMap(zones,best);else fauMap(zones,best);let total=zones.reduce((a,z)=>(Object.keys(a).forEach(k=>a[k]+=z.counts[k]),a),{available:0,occupied:0,offline:0,unknown:0});$('totals').textContent=`${total.available} Available | ${total.occupied} Occupied | ${total.offline} Offline | ${total.unknown} Unknown`;$('details').textContent=property==='broward'?'BROWARD DEMO: Simulated parking sensor data. No real Broward Mall sensors or live Firebase connection.':demo?'FAU DEMO: Simulated occupancy. No Firebase writes.':firebaseErrorMessage||'FAU LIVE: Read-only Firebase sensor data. Gray is offline; yellow is unknown.';$('disclaimer').textContent=property==='broward'?'Broward Mall diagram is an approximate custom schematic based on the supplied map screenshot. Parking rows, stall positions, zone boundaries and counts are illustrative, not a surveyed site plan.':'FAU layout follows the original four-zone demonstration style; live mode uses available sensor readings.';}
$('property').addEventListener('change',e=>{property=e.target.value;mode=property==='broward'?'demo':'live';makeDemo();draw();});$('demo').addEventListener('click',()=>{if(property==='broward')return;mode=mode==='demo'?'live':'demo';if(mode==='demo')makeDemo();draw();});$('change').addEventListener('click',()=>{if(mode!=='demo')return;const keys=Object.keys(demoUnits);const k=keys[Math.floor(Math.random()*keys.length)];if(k)demoUnits[k].occupied=!demoUnits[k].occupied;draw();});$('reset').addEventListener('click',()=>{if(mode==='demo'){makeDemo();draw();}});
async function connectFirebase(){try{const {initializeApp}=await import('https://www.gstatic.com/firebasejs/11.10.0/firebase-app.js');const {getDatabase,ref,onValue}=await import('https://www.gstatic.com/firebasejs/11.10.0/firebase-database.js');const db=getDatabase(initializeApp(firebaseConfig));const err=e=>{firebaseErrorMessage='Firebase: '+(e?.message||e);firebaseConnected=false;if(property==='fau'&&mode==='live')draw();};onValue(ref(db,'lots'),s=>{liveLots=s.val()||{};firebaseConnected=true;if(property==='fau'&&mode==='live')draw();},err);onValue(ref(db,'units'),s=>{liveUnits=s.val()||{};firebaseConnected=true;if(property==='fau'&&mode==='live')draw();},err);}catch(e){firebaseErrorMessage='Firebase: '+(e?.message||e);if(property==='fau'&&mode==='live')draw();}}
makeDemo();draw();connectFirebase();
