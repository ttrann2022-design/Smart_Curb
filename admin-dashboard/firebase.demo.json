{
  "hosting": {
    "public": "dist-demo",
    "predeploy": ["node scripts/check-build.mjs dist-demo demo"],
    "ignore": [
      "firebase.json",
      "firebase.*.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
