{
  // Smart Wheel Stop: Realtime Database security rules (DRAFT, NOT PUBLISHED)
  //
  // "Staff" means a dashboard account: a record exists at users/<uid>.
  // Driver-app accounts are signed in too, but are NOT staff.
  // The Firebase console ignores these rules, so seeding data by hand still works.
  //
  // Test locally (never touches the real database):
  //   firebase --config firebase.emulator.json emulators:start
  //
  // The hardware Receiver writes with the legacy database secret (Ryan confirmed
  // 2026-10-10). That secret bypasses these rules entirely, so publishing them
  // does not stop the Receiver. Publish by Oct 22 (test mode ends Oct 27):
  //   firebase deploy --only database --config firebase.emulator.json
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      "$uid": {
        // Everyone can read their own record (needed before it exists, at first sign-in).
        ".read": "auth != null && $uid === auth.uid",
        // Create your own record once, only if a manager invited your email,
        // with exactly the role on the invite (viewer if the invite has none),
        // and never with a siteId: only platform admins link an account to a customer.
        ".write": "auth != null && $uid === auth.uid && !data.exists() && !newData.child('siteId').exists() && newData.child('email').val() === auth.token.email && root.child('invites').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && (newData.child('role').val() === root.child('invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() || (!root.child('invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').exists() && newData.child('role').val() === 'viewer'))",
        // The customer (sites/<id>) this account's dashboard is scoped to. Platform admins
        // only, on an existing account, to an existing customer; they may also remove it.
        // The .validate repeats the platform-admin check so no cascading write can set it.
        "siteId": {
          ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.parent().exists()",
          ".validate": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,128}$/) && root.child('sites').child(newData.val()).exists()"
        },
        "role": {
          // Only managers change roles after the account exists.
          ".write": "auth != null && data.exists() && root.child('users').child(auth.uid).child('role').val() === 'manager'",
          ".validate": "newData.isString() && newData.val().matches(/^(viewer|operator|manager)$/)"
        },
        "lastActive": {
          ".write": "auth != null && $uid === auth.uid && data.parent().exists()",
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "email": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },

    "invites": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'manager'",
      "$key": {
        // Managers create and revoke invites. The invited person can read their
        // own invite and delete it once their account record is created.
        ".read": "auth != null && $key === auth.token.email.toLowerCase().replace('.', ',')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'manager' || ($key === auth.token.email.toLowerCase().replace('.', ',') && !newData.exists() && root.child('users').child(auth.uid).exists()))",
        ".validate": "!newData.exists() || newData.hasChildren(['email', 'role'])",
        "email": { ".validate": "newData.isString()" },
        "role": { ".validate": "newData.isString() && newData.val().matches(/^(viewer|operator|manager)$/)" },
        "invitedBy": { ".validate": "newData.isString()" },
        "invitedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    // Shared dashboard settings (alert thresholds). Staff read, managers write.
    "settings": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'manager'",
      "alerts": {
        "lowBattery": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "staleEnabled": { ".validate": "newData.isBoolean()" },
        "staleMinutes": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10080" },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    },

    // Site settings from the Setup wizard. Staff read, managers write.
    // setupComplete can only turn true once the site has a name and a facility type.
    "config": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()",
      "site": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'manager'",
        "siteName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "contact": {
          ".validate": "newData.hasChildren(['name', 'email'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)" },
          "phone": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        },
        "facilityType": { ".validate": "newData.isString() && newData.val().matches(/^(university|stadium|airport|hospital|shopping|city)$/)" },
        "modules": {
          "$module": { ".validate": "newData.isBoolean() && $module.matches(/^(eventMode|gateRouting|demandPricing|tailgateZones|permitTiers|semesterCalendar|rateTiers|patientPriority|staffShifts|dwellLimits|meteredParking|enforcementRouting)$/)" }
        },
        "setupComplete": { ".validate": "newData.isBoolean() && (newData.val() === false || (newData.parent().child('siteName').exists() && newData.parent().child('facilityType').exists()))" },
        "theme": { ".validate": "newData.isString() && newData.val().matches(/^(lime|paper|midnight|ember|mint|violet)$/)" },
        "$other": { ".validate": false }
      }
    },

    // Quote requests from the website. Anyone, even signed out, can CREATE one
    // fully valid lead at a new key. Only platform admins (the company console)
    // read them, change status or delete; customer managers can't.
    // Nobody can overwrite a lead or edit its fields after it's created.
    "leads": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      "$leadId": {
        // Create: only where nothing exists yet. Delete: platform admins only.
        // Status changes go through the status rule below.
        ".write": "(!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && auth != null && root.child('platformAdmins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['name', 'email', 'facilityType', 'status', 'createdAt'])",
        "name": { ".validate": "!data.exists() && newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "email": { ".validate": "!data.exists() && newData.isString() && newData.val().length < 120 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)" },
        "organization": { ".validate": "!data.exists() && newData.isString() && newData.val().length < 120" },
        "facilityType": { ".validate": "!data.exists() && newData.isString() && newData.val().matches(/^(university|stadium|airport|hospital|shopping|city)$/)" },
        "message": { ".validate": "!data.exists() && newData.isString() && newData.val().length < 1000" },
        "createdAt": { ".validate": "!data.exists() && newData.isNumber() && newData.val() === now" },
        "status": {
          ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.exists()",
          // A new lead starts as "new"; platform admins then move it between new,
          // contacted and closed. "won" means converted to a customer: it needs the
          // siteId below, and it's final.
          ".validate": "newData.isString() && (data.exists() ? ((data.val() === 'won' ? newData.val() === 'won' : newData.val().matches(/^(new|contacted|closed|won)$/)) && (newData.val() !== 'won' || newData.parent().child('siteId').exists())) : newData.val() === 'new')"
        },
        // The customer a lead was converted into. Set once, in the same write that
        // creates sites/<siteId> with fromLeadId pointing back here and sets status "won".
        "siteId": {
          ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.parent().exists() && !data.exists()",
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]+$/) && newData.parent().child('status').val() === 'won' && newData.parent().parent().parent().child('sites').child(newData.val()).child('fromLeadId').val() === $leadId"
        },
        "$other": { ".validate": false }
      }
    },

    // Vendor accounts for the company console: platformAdmins/<uid> = true.
    // Set only in the Firebase console; no client can write it. Each signed-in
    // user can read their own entry, so the console can check its access.
    "platformAdmins": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid"
      }
    },

    // Customer deployments, managed in the company console. Platform admins only.
    "sites": {
      ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
      "$siteId": {
        ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['name', 'type', 'status', 'createdAt'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
        "type": { ".validate": "newData.isString() && newData.val().matches(/^(campus|mall|garage|hotel|other)$/)" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(prospect|active|paused)$/)" },
        "contactName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "contactEmail": { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)" },
        "notes": { ".validate": "newData.isString() && newData.val().length <= 500" },
        // The quote request the site came from. Set only by converting that lead: in the
        // same write the lead gets siteId = this site, and it can't already be "won",
        // so one lead never becomes two customers. Unchanged values always pass.
        "fromLeadId": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]+$/) && (newData.val() === data.val() || (root.child('leads').child(newData.val()).child('status').val() !== 'won' && newData.parent().parent().parent().child('leads').child(newData.val()).child('siteId').val() === $siteId))" },
        // Server time on create, then fixed.
        "createdAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
        "$other": { ".validate": false }
      }
    },

    // Public read: the lot entrance sign runs signed-out on a TV. No customer role
    // writes lots; the Receiver uses the database secret, which skips these rules.
    "lots": {
      ".read": true,
      "$lotId": {
        // Platform admins create a lot, but never replace or delete one. The ID is lowercase
        // letters and numbers; a new lot has name, siteId and optional latitude/longitude,
        // totalSpots and openSpots (only alongside totalSpots, and equal to it), and nothing
        // else. Capacity comes from the curbs, so the console leaves both counts out.
        ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && !data.exists() && newData.exists()",
        ".validate": "data.exists() || ($lotId.matches(/^[a-z0-9]+$/) && $lotId.length <= 80 && newData.hasChildren(['name', 'siteId']))",
        // After that they change only name, totalSpots, latitude and longitude.
        "name": {
          ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.parent().exists() && newData.exists()",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
        },
        "totalSpots": {
          ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.parent().exists() && newData.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5000 && newData.val() % 1 === 0"
        },
        "latitude": {
          ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.parent().exists()",
          ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
        },
        "longitude": {
          ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.parent().exists()",
          ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
        },
        // Optional when a platform admin creates the lot, and then only equal to totalSpots;
        // after that it belongs to the hardware.
        "openSpots": { ".validate": "data.exists() || newData.val() === newData.parent().child('totalSpots').val()" },
        // No other field on a new lot (units and the rest come from the hardware).
        "$other": { ".validate": "data.exists() || data.parent().exists()" },
        // Which customer site a lot belongs to. Platform admins only, on a lot
        // that already exists, and only to a site that exists once the write lands
        // (so a site can be created and given lots in one write), or removed.
        "siteId": {
          ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.parent().exists()",
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]+$/) && newData.parent().parent().parent().child('sites').child(newData.val()).exists()"
        }
      }
    },

    "units": {
      ".read": true,
      "$unitId": {
        // Operators and managers set the LED zone, brightness and panel text.
        "ledColor": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val().matches(/^(operator|manager)$/)",
          ".validate": "newData.isString() && newData.val().matches(/^(red|blue|green|gold|white)$/)"
        },
        // Whole percent, 0 to 100.
        "ledBrightness": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val().matches(/^(operator|manager)$/)",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0"
        },
        "panelText": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val().matches(/^(operator|manager)$/)",
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        // Managers put a curb that has already reported into a lot (Setup, Connect curbs).
        // The lot must exist, and this can't create a unit that never reported.
        "lot": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'manager' && data.parent().exists()",
          ".validate": "newData.isString() && root.child('lots').child(newData.val()).exists()"
        },

        // ============ RECEIVER SECTION: OPTIONAL, FOR A FUTURE FIREBASE AUTH ACCOUNT ============
        // Today the Receiver uses the legacy database secret, which skips
        // every rule in this file (including .validate), so it does NOT need this section.
        //
        // As written, the placeholder UID matches no one, so these three .write rules
        // grant nothing. Leaving them like this is safe to publish.
        //
        // When the Receiver moves to a Firebase Auth account, replace the placeholder in
        // all three places so it can write ONLY these fields on units/<id>:
        //   - Firebase account (email/password):  auth != null && auth.uid === '<receiver uid>'
        //   - Custom token with a claim:          auth != null && auth.token.receiver === true
        "occupied": {
          ".write": "auth != null && auth.uid === 'REPLACE_WITH_RECEIVER_UID'",
          ".validate": "newData.isBoolean()"
        },
        "lastUpdated": {
          ".write": "auth != null && auth.uid === 'REPLACE_WITH_RECEIVER_UID'",
          ".validate": "newData.isNumber()"
        },
        "lastSnapshot": {
          ".write": "auth != null && auth.uid === 'REPLACE_WITH_RECEIVER_UID'",
          ".validate": "newData.isString()"
        }
        // ===========================================================================================
      }
    },

    // Ryan's old Receiver test nodes (deleted 2026-10-10). Staff can read them if they
    // return; nothing in the dashboard writes here. A Receiver using the database secret
    // can still write here. If it moves to a Firebase Auth account and still needs these,
    // give them the same condition as the RECEIVER section above.
    "curbs": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()"
    },
    "status": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()"
    },

    // Occupancy history for Analytics (nothing writes the real one yet).
    "history": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()"
    },

    // Transmission latency samples, latency/<unitId>/<sampleId> with optional
    // eventAgeMs, rxToWriteMs and lastUpdated. Staff read them on Analytics.
    // No client writes: there is no .write here, and the root denies writes.
    // The Receiver writes with the legacy database secret, which bypasses these
    // rules. Simulated samples live under demo/latency (see "demo" below).
    "latency": {
      ".read": "auth != null && root.child('users').child(auth.uid).exists()"
    },

    // Driver-app accounts: each driver reads and writes only their own data.
    "drivers": {
      "$uid": {
        ".read": "auth != null && $uid === auth.uid",
        ".write": "auth != null && $uid === auth.uid"
      }
    },

    // Simulation and demo data. Public read (demo sign, driver app);
    // only dashboard staff can write. Real curbs never live here.
    // Read is granted per child, not on demo/ itself, so demo/sites and
    // demo/platformAdmins stay private like their live versions.
    "demo": {
      // Simulated site settings follow the same rules as config/site, so Setup
      // behaves the same in Simulation: only managers write, same validation.
      "config": {
        ".read": true,
        "site": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'manager'",
          "siteName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
          "contact": {
            ".validate": "newData.hasChildren(['name', 'email'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
            "email": { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)" },
            "phone": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          },
          "facilityType": { ".validate": "newData.isString() && newData.val().matches(/^(university|stadium|airport|hospital|shopping|city)$/)" },
          "modules": {
            "$module": { ".validate": "newData.isBoolean() && $module.matches(/^(eventMode|gateRouting|demandPricing|tailgateZones|permitTiers|semesterCalendar|rateTiers|patientPriority|staffShifts|dwellLimits|meteredParking|enforcementRouting)$/)" }
          },
          "setupComplete": { ".validate": "newData.isBoolean() && (newData.val() === false || (newData.parent().child('siteName').exists() && newData.parent().child('facilityType').exists()))" },
          "theme": { ".validate": "newData.isString() && newData.val().matches(/^(lime|paper|midnight|ember|mint|violet)$/)" },
          "$other": { ".validate": false }
        }
      },
      // Fake quote requests for the company console's Simulation mode. Platform
      // admins only, like leads/. They're fake, so the console seeds them with past
      // dates and any status, and can replace or delete them; the shape is still
      // checked, and converting follows the same won/siteId rules as leads/.
      "leads": {
        ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
        "$leadId": {
          ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['name', 'email', 'facilityType', 'status', 'createdAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
          "email": { ".validate": "newData.isString() && newData.val().length < 120 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)" },
          "organization": { ".validate": "newData.isString() && newData.val().length < 120" },
          "facilityType": { ".validate": "newData.isString() && newData.val().matches(/^(university|stadium|airport|hospital|shopping|city)$/)" },
          "message": { ".validate": "newData.isString() && newData.val().length < 1000" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "status": { ".validate": "newData.isString() && newData.val().matches(/^(new|contacted|closed|won)$/) && (newData.val() !== 'won' || newData.parent().child('siteId').exists()) && (data.val() !== 'won' || newData.val() === 'won')" },
          "siteId": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]+$/) && (newData.val() === data.val() || (newData.parent().child('status').val() === 'won' && newData.parent().parent().parent().child('sites').child(newData.val()).child('fromLeadId').val() === $leadId))" },
          "$other": { ".validate": false }
        }
      },
      // Simulated lots: public read, staff write, as before. siteId follows the live
      // rule: only platform admins set it, and only to an existing demo/sites entry.
      // Staff writes cascade from demo/lots, so the platform-admin check sits in
      // .validate too. Staff can still drop siteId (Simulation's reset rewrites demo/lots).
      // Platform admins create and edit lots as in lots/. Those checks skip staff, so the
      // simulator's writes are exactly as before.
      "lots": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).exists()",
        "$lotId": {
          // Platform admins create a lot, but never replace or delete one. The ID is lowercase
          // letters and numbers; a new lot has name, siteId and optional latitude/longitude,
          // totalSpots and openSpots (only alongside totalSpots, and equal to it), and nothing
          // else. Capacity comes from the curbs, so the console leaves both counts out.
          ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && !data.exists() && newData.exists()",
          ".validate": "auth != null && root.child('users').child(auth.uid).exists() || (data.exists() || ($lotId.matches(/^[a-z0-9]+$/) && $lotId.length <= 80 && newData.hasChildren(['name', 'siteId'])))",
          // After that they change only name, totalSpots, latitude and longitude.
          "name": {
            ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.parent().exists() && newData.exists()",
            ".validate": "auth != null && root.child('users').child(auth.uid).exists() || (newData.isString() && newData.val().length >= 1 && newData.val().length <= 80)"
          },
          "totalSpots": {
            ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.parent().exists() && newData.exists()",
            ".validate": "auth != null && root.child('users').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 5000 && newData.val() % 1 === 0)"
          },
          "latitude": {
            ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.parent().exists()",
            ".validate": "auth != null && root.child('users').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= -90 && newData.val() <= 90)"
          },
          "longitude": {
            ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.parent().exists()",
            ".validate": "auth != null && root.child('users').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= -180 && newData.val() <= 180)"
          },
          // Optional when a platform admin creates the lot, and then only equal to totalSpots;
          // after that it belongs to the hardware.
          "openSpots": { ".validate": "auth != null && root.child('users').child(auth.uid).exists() || (data.exists() || newData.val() === newData.parent().child('totalSpots').val())" },
          // No other field on a new lot (units and the rest come from the hardware).
          "$other": { ".validate": "auth != null && root.child('users').child(auth.uid).exists() || (data.exists() || data.parent().exists())" },
          "siteId": {
            ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && data.parent().exists()",
            ".validate": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true && newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]+$/) && newData.parent().parent().parent().child('sites').child(newData.val()).exists()"
          }
        }
      },
      // Simulated customer sites: same rules as sites/. Platform admin status always
      // comes from the live platformAdmins/, so one entry covers both modes.
      "sites": {
        ".read": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
        "$siteId": {
          ".write": "auth != null && root.child('platformAdmins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['name', 'type', 'status', 'createdAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
          "type": { ".validate": "newData.isString() && newData.val().matches(/^(campus|mall|garage|hotel|other)$/)" },
          "status": { ".validate": "newData.isString() && newData.val().matches(/^(prospect|active|paused)$/)" },
          "contactName": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "contactEmail": { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/)" },
          "notes": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "fromLeadId": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]+$/) && (newData.val() === data.val() || (root.child('demo').child('leads').child(newData.val()).child('status').val() !== 'won' && newData.parent().parent().parent().child('leads').child(newData.val()).child('siteId').val() === $siteId))" },
          "createdAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
          "$other": { ".validate": false }
        }
      },
      // Mirrors platformAdmins/ for parity: read your own entry, no client writes.
      // It grants nothing; access to demo/sites is checked against the live list.
      "platformAdmins": {
        "$uid": {
          ".read": "auth != null && $uid === auth.uid"
        }
      },
      // Accounts are live only (users/). Named here so demo/$other can't be used to
      // write a users/<uid>/siteId look-alike under demo/: no client reads or writes it.
      "users": {
        ".read": false,
        ".write": false
      },
      // Everything else under demo/ (units, history, latency, simLock): any staff account.
      "$other": {
        ".read": true,
        ".write": "auth != null && root.child('users').child(auth.uid).exists()"
      }
    }
  }
}
